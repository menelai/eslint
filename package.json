{
  "name": "@kovalenko/eslint",
  "version": "2.0.1",
  "description": "Shared eslint rules",
  "author": "kovalenko@gmail.com",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./angular": "./angular/index.js",
    "./nestjs": "./nestjs/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.x"
  },
  "scripts": {
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "eslint": ">= 10",
    "eslint-plugin-import-x": "^4.x",
    "@stylistic/eslint-plugin": "^5.x",
    "@typescript-eslint/eslint-plugin": "^8.x",
    "@typescript-eslint/parser": "^8.x",
    "@typescript-eslint/utils": "^8.x"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "semantic-release": "^24.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menelai/eslint.git"
  },
  "bugs": {
    "url": "https://github.com/menelai/eslint/issues"
  },
  "files": [
    "index.js",
    "nestjs/**/*",
    "angular/**/*",
    "common/**/*",
    "package.json",
    "package-lock.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
